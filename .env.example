# Postgres connection used by the app. On Vercel + Neon this is the pooled URL.
DATABASE_URL="postgresql://justonce:justonce@localhost:5432/justonce"
# Direct (non-pooled) URL used for migrations. Leave it out if you only have one URL.
DATABASE_URL_UNPOOLED="postgresql://justonce:justonce@localhost:5432/justonce"

# Optional: set to enable POST /api/demo/reset (re-seeds the demo data). Keep it secret.
DEMO_RESET_KEY=""

# Set to "false" to hide the one-tap demo account buttons on the log-in page.
NEXT_PUBLIC_DEMO_MODE="true"

# AI features (photo-to-listing, describe-what-you-need search, photo search, pickup/return photo comparison). Server-side only,
# never sent to the browser. Set ONE of the two keys. With neither, the app works exactly as
# before and the AI buttons are hidden.
#   - Gemini has a free tier: create a key at https://aistudio.google.com/apikey (no card needed).
#     On the free tier Google may use what you send to improve its products.
#   - Anthropic is paid per call: create a key at https://console.anthropic.com
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional: only needed when both keys are set. "anthropic" (default) or "gemini".
AI_PROVIDER=""
# Optional: override the model, e.g. "gemini-3.5-flash-lite" or "claude-haiku-5-5". Leave empty for the default.
AI_MODEL=""

# Rent-versus-buy line on item pages ("About £1,150 to buy new. You save £1,062").
# With an AI key set above, the buy price is an AI estimate: the model searches the web for current
# UK prices first when the key's plan includes Google Search grounding, and estimates from what it
# knows otherwise. The eBay keys below are optional and take priority: live eBay listings instead of an estimate.
# Server-side only. With neither, the line uses the owner's replacement value.
# Create keys at https://developer.ebay.com/my/keys (free). Sandbox keys return made-up listings,
# so use production keys for real prices; eBay has to approve production use of its Buy APIs.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# Optional: "production" (default) or "sandbox". Must match the kind of keys above.
EBAY_ENV=""

# "Rather own it? See it on Amazon or eBay" links on item pages. Optional: the links work without
# these, they just earn nothing. With either set, a commission notice is shown next to the links.
#   - Amazon Associates tracking ID (UK IDs end in -21): https://affiliate-program.amazon.co.uk
#   - eBay Partner Network campaign ID: https://partnernetwork.ebay.co.uk
AMAZON_ASSOCIATE_TAG=""
EBAY_CAMPAIGN_ID=""
