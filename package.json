{
  "name": "just-once",
  "version": "1.0.0",
  "private": true,
  "description": "Just Once: a peer-to-peer marketplace for renting the things you only need once.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs migrate deploy && tsx prisma/seed.ts",
    "setup": "node scripts/prisma.mjs migrate deploy && tsx prisma/seed.ts",
    "vercel-build": "node scripts/prisma.mjs migrate deploy && tsx prisma/seed.ts --if-empty && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/parkinsans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
