// Just Once data model.
//
// Money is stored in pence (Int). Calendar dates (availability, bookings) are
// stored as Postgres `date` values and handled as UTC midnight in JavaScript.
//
// Swap-ready: an item can be offered for RENTAL today. `ExchangeType.SWAP`,
// `Listing.exchangeTypes` and `Booking.type` / `Booking.offeredListingId` are
// in place so a "swap" option can be added later without reshaping bookings.
// Nothing in the app creates swaps yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Category {
  FORMALWEAR
  CAMERAS
  CAMPING
  SEASONAL
  CLOTHING
  SHOES
  BAGS
  JEWELLERY
  WATCHES
  ACCESSORIES
  COSTUMES
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// How an item changes hands. Only RENTAL is offered in this version.
enum ExchangeType {
  RENTAL
  SWAP
}

/// How an item gets from the owner to the renter (and back).
enum HandoverMethod {
  MEET
  COURIER
  LOCKER
}

enum BookingStatus {
  REQUESTED // renter has asked, owner hasn't answered
  ACCEPTED  // owner accepted, payment taken, waiting for pickup
  ACTIVE    // both sides confirmed pickup, item is out
  COMPLETED // both sides confirmed return, deposit released
  DECLINED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DepositStatus {
  NONE
  HELD          // taken when the owner accepts
  IN_REVIEW     // the owner has claimed part or all of it
  PART_RELEASED // a claim was settled: some kept, the rest returned
  KEPT          // the whole deposit went to the owner
  RELEASED      // returned in full
}

enum ClaimReason {
  DAMAGED
  MISSING_PARTS
  NOT_CLEANED
  RETURNED_LATE
}

enum ClaimStatus {
  OPEN      // waiting for the renter
  ACCEPTED  // renter agreed, amount kept
  CONTESTED // renter disagreed, Just Once reviews it
  RESOLVED  // settled after review
}

enum PayoutStatus {
  NONE
  SCHEDULED
  PAID
}

enum CheckStage {
  PICKUP
  RETURN
}

enum Party {
  OWNER
  RENTER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  bio          String?
  area         String?
  avatarUrl    String?
  /// Simulated identity check: set when the user completes the demo flow.
  verifiedAt   DateTime?
  ratingCount  Int       @default(0)
  ratingSum    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  listings        Listing[]
  rentals         Booking[]       @relation("RenterBookings")
  ownerBookings   Booking[]       @relation("OwnerBookings")
  reviewsWritten  Review[]        @relation("ReviewAuthor")
  reviewsReceived Review[]        @relation("ReviewSubject")
  checks          HandoverCheck[]
  events          BookingEvent[]
  images          ImageBlob[]
}

model Session {
  /// SHA-256 of the token stored in the cookie, so a database leak can't be replayed.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Listing {
  id            String         @id @default(cuid())
  ownerId       String
  title         String
  description   String
  category      Category
  condition     Condition
  brand         String?
  size          String?
  pricePerDay   Int
  deposit       Int
  /// What it would cost to replace, in pence. Used to suggest a fair deposit.
  replacementValue Int?
  /// Typical price to buy it new, in pence, looked up by src/server/market-price.ts and cached here.
  /// Renters see this next to the rental price; replacementValue is the fallback.
  marketPrice          Int?
  /// Where it came from: "EBAY" (median of live listings), "AI_WEB" (AI estimate after a web search) or "AI" (AI estimate).
  marketPriceSource    String?
  /// How many listings or web pages the price came from.
  marketPriceCount     Int?
  /// The eBay search the price came from, so renters can check it.
  marketPriceUrl       String?
  /// Last lookup, hit or miss, so a miss isn't retried on every page view.
  marketPriceCheckedAt DateTime?
  /// Opt out of the reduced deposit for trusted renters.
  fullDepositOnly Boolean @default(false)
  /// Neighbourhood slug from src/lib/areas.ts, e.g. "hackney".
  area          String
  /// Shared with the renter only once a booking is accepted.
  pickupNotes   String?
  /// Optional exact pickup point. Like pickupNotes, only ever sent to a renter with an accepted booking.
  pickupLat     Float?
  pickupLng     Float?
  /// Ordered photo URLs; the first one is the cover.
  photos        String[]
  availableFrom DateTime       @db.Date
  availableTo   DateTime       @db.Date
  exchangeTypes ExchangeType[] @default([RENTAL])
  handoverMethods HandoverMethod[] @default([MEET])
  status        ListingStatus  @default(ACTIVE)
  featured      Boolean        @default(false)
  ratingCount   Int            @default(0)
  ratingSum     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blockedDates BlockedDate[]
  bookings     Booking[]     @relation("BookedListing")
  swapOffers   Booking[]     @relation("SwapOfferedListing")

  @@index([status, category])
  @@index([ownerId])
}

/// A single day the owner has marked as unavailable inside the availability window.
model BlockedDate {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime @db.Date
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
}

model Booking {
  id               String        @id @default(cuid())
  type             ExchangeType  @default(RENTAL)
  listingId        String
  ownerId          String
  renterId         String
  /// Reserved for swaps: the requester's own item offered in exchange.
  offeredListingId String?
  startDate        DateTime      @db.Date
  /// Inclusive: the last day the renter has the item.
  endDate          DateTime      @db.Date
  days             Int
  pricePerDay      Int
  subtotal         Int
  serviceFee       Int
  /// What the renter pays (subtotal + service fee). The deposit is held separately.
  total            Int
  /// The deposit this renter pays (half the listed one for trusted renters).
  deposit          Int
  /// True when the trusted-renter reduction applied.
  depositReduced   Boolean       @default(false)
  /// Part of the deposit kept by the owner after a claim.
  depositKept      Int           @default(0)
  handoverMethod   HandoverMethod @default(MEET)
  /// Simulated delivery cost for both ways, included in `total`.
  deliveryFee      Int           @default(0)
  /// Courier address; shown to the owner only once the booking is accepted.
  deliveryAddress  String?
  lockerName       String?
  message          String?
  status           BookingStatus @default(REQUESTED)
  paymentStatus    PaymentStatus @default(UNPAID)
  depositStatus    DepositStatus @default(NONE)
  payoutStatus     PayoutStatus  @default(NONE)
  declineReason    String?
  cancelledById    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  respondedAt      DateTime?
  pickedUpAt       DateTime?
  returnedAt       DateTime?
  cancelledAt      DateTime?

  listing        Listing         @relation("BookedListing", fields: [listingId], references: [id], onDelete: Cascade)
  offeredListing Listing?        @relation("SwapOfferedListing", fields: [offeredListingId], references: [id], onDelete: SetNull)
  owner          User            @relation("OwnerBookings", fields: [ownerId], references: [id], onDelete: Cascade)
  renter         User            @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  checks         HandoverCheck[]
  reviews        Review[]
  events         BookingEvent[]
  claim          DepositClaim?

  @@index([listingId, status])
  @@index([renterId, status])
  @@index([ownerId, status])
}

/// An owner's claim against the deposit after a problem at the return check.
model DepositClaim {
  id             String      @id @default(cuid())
  bookingId      String      @unique
  amount         Int
  reason         ClaimReason
  ownerNote      String
  photos         String[]
  status         ClaimStatus @default(OPEN)
  renterNote     String?
  renterPhotos   String[]
  resolvedAmount Int?
  createdAt      DateTime    @default(now())
  respondedAt    DateTime?
  resolvedAt     DateTime?
  booking        Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// One side's confirmation at pickup or return, with condition photos.
model HandoverCheck {
  id             String     @id @default(cuid())
  bookingId      String
  stage          CheckStage
  party          Party
  userId         String
  condition      Condition
  /// Pickup: item matches the listing. Return: item is in the same condition as at pickup.
  conditionOk    Boolean    @default(true)
  notes          String?
  photos         String[]
  /// AI comparison of these photos with the earlier ones (listing photos at pickup, pickup photos at return).
  /// Advice for the two people only: nothing reads it to change a booking or a deposit. Shape: src/lib/photo-comparison.ts.
  aiComparison   Json?
  createdAt      DateTime   @default(now())
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, stage, party])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  authorId   String
  subjectId  String
  /// RENTER = a renter reviewing the owner and item; OWNER = an owner reviewing the renter.
  authorRole Party
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject    User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

/// Timeline entry shown on the booking page ("Priya accepted", "Deposit released", ...).
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  actorId   String?
  type      String
  note      String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

/// Uploaded photos live in the database so the app deploys without a separate file store.
model ImageBlob {
  id        String   @id @default(cuid())
  ownerId   String?
  mimeType  String
  data      Bytes
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}
